APP_NAME="TALMA Practice Pal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wespeak
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Privacy & Recording Settings
PRIVACY_ALLOW_UPLOAD=false
RECORDING_MAX_SECONDS=20
SPEECH_FEEDBACK_ENABLED=true
MEDIA_DISK=public
# Alternative: MEDIA_DISK=s3
PRACTICE_SESSION_COOKIE=talma_session_id

# OpenAI (used for automatic vocabulary translations and image generation)
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
# Arabic vocabulary style: saudi (default, Gulf/Saudi colloquial) or msa (Modern Standard Arabic)
OPENAI_ARABIC_VARIANT=saudi
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
# Image size options: 1024x1024 (square), 1024x1792 (portrait), 1792x1024 (landscape)

# Leonardo.ai (used for image generation - preferred over OpenAI for flashcards)
LEONARDO_API_KEY=
LEONARDO_MODEL=leonardo-flash-xl
LEONARDO_SIZE=1024x1024
# Get API key from: https://app.leonardo.ai/settings/api
# Model options: leonardo-flash-xl (fast), leonardo-vision-xl (high quality), etc.

# Filesystem Disk for Recordings (if uploads enabled)
PRIVACY_ALLOW_UPLOAD=false
RECORDING_MAX_SECONDS=20

# Voice training corpus (anonymized student recordings)
VOICE_TRAINING_DISK=voice_training
VOICE_TRAINING_DISK_DRIVER=local
# VOICE_TRAINING_DISK_DRIVER=s3
# AWS_VOICE_TRAINING_BUCKET=   # falls back to AWS_BUCKET when unset

# Comma-separated emails that may view voice samples (in addition to global admins)
# VOICE_SAMPLE_VIEWER_EMAILS=researcher@example.com
# VOICE_WAIVER_TEXT="I agree that my voice recordings may be saved anonymously to help improve voice recognition tools."

# Summer Practice Pal daily usage email (Asia/Jerusalem day window)
SUMMER_DAILY_REPORT_EMAILS=daniel@talmaisrael.com
SUMMER_DAILY_REPORT_TIMEZONE=Asia/Jerusalem

# AWS S3 (optional, only if using S3 for storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ElevenLabs (only needed for TTS generation script, NOT runtime)
# ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Image APIs (for auto-finding vocabulary images)
# Provider priority (comma-separated). Default skips Freepik/Magnific and Flaticon.
# Options: iconify (free, no key), stock (Unsplash/Pixabay), leonardo, openai, flaticon, freepik
IMAGE_PROVIDERS=iconify,stock,leonardo,openai
IMAGE_ICONIFY_ENABLED=true
IMAGE_ICONIFY_SIZE=512

# Magnific / Freepik (optional — removed from default provider list)
# FREEPIK_API_KEY=

# Flaticon (optional, separate API key from Freepik)
# FLATICON_API_KEY=

# Stock photo APIs (fallback if Flaticon doesn't have the icon)
# Unsplash: https://unsplash.com/developers (50 requests/hour, 5,000/month)
# Pixabay: https://pixabay.com/api/docs/ (5,000 requests/month)
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

