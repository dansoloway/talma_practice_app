APP_NAME="TALMA Practice Pal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wespeak
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Privacy & Recording Settings
PRIVACY_ALLOW_UPLOAD=false
RECORDING_MAX_SECONDS=20
MEDIA_DISK=public
# Alternative: MEDIA_DISK=s3
PRACTICE_SESSION_COOKIE=talma_session_id

# Filesystem Disk for Recordings (if uploads enabled)
RECORDING_DISK=local
# Alternative: RECORDING_DISK=s3

# AWS S3 (optional, only if using S3 for storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ElevenLabs (only needed for TTS generation script, NOT runtime)
# ELEVENLABS_API_KEY=

