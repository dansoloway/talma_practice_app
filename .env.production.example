APP_NAME="WeSpeak"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=your-production-db-host
DB_PORT=3306
DB_DATABASE=wespeak_production
DB_USERNAME=your-db-username
DB_PASSWORD=your-secure-db-password

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# WeSpeak Specific Configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL=eleven_multilingual_v2
ADMIN_PASSWORD=your-secure-admin-password-here
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_ARABIC_VARIANT=saudi
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
# Image size options: 1024x1024 (square), 1024x1792 (portrait), 1792x1024 (landscape)

# Image generation (vocabulary icons)
# iconify = free, no API key. stock = Unsplash + Pixabay. leonardo/openai = AI fallbacks.
IMAGE_PROVIDERS=iconify,stock,leonardo,openai
IMAGE_ICONIFY_ENABLED=true
IMAGE_ICONIFY_SIZE=512

# Leonardo.ai (optional AI fallback)
LEONARDO_API_KEY=
LEONARDO_MODEL=leonardo-flash-xl
LEONARDO_SIZE=1024x1024
# Get API key from: https://app.leonardo.ai/settings/api
# Model options: leonardo-flash-xl (fast), leonardo-vision-xl (high quality), etc.
